{
  "name": "stage-music",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Stage Music — cifras, repertórios e direção musical ao vivo",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "test:security": "firebase emulators:exec --project demo-stage-music --only firestore,storage \"node --test tests/security.mjs\""
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.18.0",
    "firebase-tools": "15.29.0",
    "jsdom": "30.0.1",
    "jszip": "3.10.1"
  },
  "packageManager": "pnpm@11.19.0"
}
